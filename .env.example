# EMail-Archive-UI Environment Variables (FOSS Example)

# Public backend API endpoint URL
VITE_API_URL=https://api.example.com/

# Public export API endpoint URL. It must authenticate users server-side; never
# add a private API key to a VITE_* variable because Vite exposes it in the app.
VITE_EXPORT_API_URL=https://export-api.example.com/

# Optional public client identifier required by the export API. This is visible
# in the browser and must not grant access by itself.
VITE_API_KEY=your_public_export_client_identifier

# Google reCAPTCHA site key for authentication forms
VITE_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key

# Current application version
VITE_APP_VERSION=0.1.9

# WebSocket server URL for real-time notifications
VITE_WSS_URL=wss://realtime.example.com

# Archive base domain
VITE_ARCHIVE_DOMAIN=archive.example.com
